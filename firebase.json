{
  "hosting": {
    "public": "build/web",
    "ignore": ["firebase.json", "**/.*"],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": { "host": "127.0.0.1", "port": 9099 },
    "firestore": { "host": "127.0.0.1", "port": 8080 },
    "functions": { "host": "127.0.0.1", "port": 5001 },
    "storage": { "host": "127.0.0.1", "port": 9199 },
    "ui": { "enabled": true, "host": "127.0.0.1", "port": 4000 },
    "singleProjectMode": true
  },
  "storage": {
    "rules": "storage.rules"
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "loyalo-app",
          "appId": "1:1095968052802:android:5717ec5129e7bf765c7fdb",
          "fileOutput": "android/app/src/production/google-services.json"
        },
        "pilot": {
          "projectId": "loyalo-pilot",
          "appId": "1:974504708310:android:b1a7caa308984db8bf2177",
          "fileOutput": "android/app/src/pilot/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "loyalo-app",
          "appId": "1:1095968052802:ios:7a520e496938170c5c7fdb",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        },
        "pilot": {
          "projectId": "loyalo-pilot",
          "appId": "1:974504708310:ios:d956a6e851250a3dbf2177",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/config/pilot/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "loyalo-app",
          "configurations": {
            "android": "1:1095968052802:android:5717ec5129e7bf765c7fdb",
            "ios": "1:1095968052802:ios:7a520e496938170c5c7fdb",
            "web": "1:1095968052802:web:8fba68d488eab0a65c7fdb"
          }
        },
        "lib/firebase_options_pilot.dart": {
          "projectId": "loyalo-pilot",
          "configurations": {
            "android": "1:974504708310:android:b1a7caa308984db8bf2177",
            "ios": "1:974504708310:ios:d956a6e851250a3dbf2177"
          }
        }
      }
    }
  }
}
