rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isMerchant() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/merchants/$(request.auth.uid));
    }

    // Profil du client connecté : lisible par tout compte authentifié
    // (l'espace commerçant doit pouvoir rechercher/afficher un client),
    // mais modifiable seulement par le propriétaire du profil.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Lien commerçant -> restaurant : privé à chaque commerçant.
    match /merchants/{merchantId} {
      allow read, write: if isSignedIn() && request.auth.uid == merchantId;
    }

    // Catalogue des restaurants partenaires : lecture pour tout compte
    // authentifié, création à l'inscription commerçant, pas de
    // modification/suppression depuis le client pour l'instant.
    match /restaurants/{restaurantId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Passages : seul un compte commerçant peut valider (créer) une
    // visite, ce qui protège la logique anti-fraude décrite dans le
    // document de présentation du projet.
    match /visits/{visitId} {
      allow read: if isSignedIn();
      allow create: if isMerchant();
      allow update, delete: if false;
    }

    // Récompenses débloquées : créées par le commerçant lors de la
    // validation, marquées "utilisées" par le client depuis son app.
    match /rewards/{rewardId} {
      allow read: if isSignedIn();
      allow create: if isMerchant();
      allow update: if isSignedIn();
      allow delete: if false;
    }

    // Catalogue de récompenses par restaurant : géré par le commerçant.
    match /rewardDefinitions/{id} {
      allow read: if isSignedIn();
      allow write: if isMerchant();
    }

    // Liste "envie d'y aller" : des lieux réels enregistrés par un client,
    // indépendants du programme de fidélité. Strictement privée à son
    // propriétaire.
    match /wishlist/{id} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // Avis clients sur un restaurant : lisibles par tout compte
    // authentifié (moyenne affichée à tous), mais un client ne peut créer
    // ou modifier que son propre avis (id de document = restaurantId_uid).
    match /reviews/{id} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        id == request.resource.data.restaurantId + '_' + request.auth.uid;
      allow delete: if false;
    }

    // Parrainage : créé une seule fois, au moment de l'inscription du
    // filleul, par le filleul lui-même (referredUserId == son propre uid)
    // — c'est ce qui crédite le parrain de points de bienvenue.
    match /referrals/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.referredUserId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
