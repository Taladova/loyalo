rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isMerchant() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/merchants/$(request.auth.uid));
    }

    function merchantRestaurantId() {
      return get(/databases/$(database)/documents/merchants/$(request.auth.uid)).data.restaurantId;
    }

    function isMerchantForRestaurant(restaurantId) {
      return isMerchant() && merchantRestaurantId() == restaurantId;
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function hasOnlyFields(keys) {
      return request.resource.data.keys().hasOnly(keys);
    }

    function merchantCanAccessUser(userId) {
      return isMerchant() &&
        exists(/databases/$(database)/documents/restaurantCustomers/$(merchantRestaurantId() + '_' + userId));
    }

    function restaurantOwnerCanCreate() {
      return isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.name is string &&
        request.resource.data.cuisine is string &&
        request.resource.data.rewardThreshold is int &&
        request.resource.data.rewardLabel is string;
    }

    function restaurantOwnerCanUpdate() {
      return isSignedIn() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId;
    }

    function linkedMerchantCanClaimRestaurant(restaurantId) {
      return isMerchantForRestaurant(restaurantId) &&
        resource.data.ownerId == null &&
        request.resource.data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow get: if isSelf(userId) || merchantCanAccessUser(userId);
      allow list: if false;
      allow create: if isSelf(userId) &&
        hasOnlyFields([
          'name', 'email', 'phone', 'referralCode', 'createdAt',
          'notificationPreferences', 'updatedAt'
        ]) &&
        request.resource.data.name is string &&
        request.resource.data.email is string &&
        request.resource.data.referralCode is string;
      allow update: if isSelf(userId) &&
        changedOnly(['name', 'email', 'phone', 'notificationPreferences', 'updatedAt']);
      allow delete: if isSelf(userId);

      match /devices/{deviceId} {
        allow get, list, create, update, delete: if isSelf(userId);
      }
    }

    match /referralCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSelf(request.resource.data.userId) &&
        hasOnlyFields(['userId', 'updatedAt']);
      allow update: if isSelf(resource.data.userId) &&
        request.resource.data.userId == resource.data.userId &&
        changedOnly(['updatedAt']);
      allow delete: if false;
    }

    match /validationCodes/{code} {
      allow get: if isMerchant() || isSelf(resource.data.userId);
      allow list: if false;
      allow create: if isSelf(request.resource.data.userId) &&
        hasOnlyFields(['userId', 'dateKey', 'expiresAt', 'updatedAt']) &&
        request.resource.data.dateKey is string &&
        request.resource.data.expiresAt is timestamp;
      allow update: if isSelf(resource.data.userId) &&
        request.resource.data.userId == resource.data.userId &&
        changedOnly(['dateKey', 'expiresAt', 'updatedAt']) &&
        request.resource.data.dateKey is string &&
        request.resource.data.expiresAt is timestamp;
      allow delete: if false;
    }

    match /merchants/{merchantId} {
      allow get: if isSelf(merchantId);
      allow list: if false;
      allow create, update: if isSelf(merchantId) &&
        request.resource.data.restaurantId is string &&
        get(/databases/$(database)/documents/restaurants/$(request.resource.data.restaurantId)).data.ownerId == request.auth.uid;
      allow delete: if isSelf(merchantId);
    }

    match /restaurantCustomers/{id} {
      allow get, list: if isSignedIn() &&
        (resource.data.userId == request.auth.uid ||
          isMerchantForRestaurant(resource.data.restaurantId));
      allow create: if isSignedIn() &&
        request.resource.data.restaurantId is string &&
        request.resource.data.userId is string &&
        (
          request.resource.data.userId == request.auth.uid ||
          isMerchantForRestaurant(request.resource.data.restaurantId)
        ) &&
        get(/databases/$(database)/documents/restaurants/$(request.resource.data.restaurantId)).data.active == true &&
        id == request.resource.data.restaurantId + '_' + request.resource.data.userId &&
        hasOnlyFields(['restaurantId', 'userId', 'updatedAt']);
      allow update: if isSignedIn() &&
        request.resource.data.restaurantId == resource.data.restaurantId &&
        request.resource.data.userId == resource.data.userId &&
        (
          resource.data.userId == request.auth.uid ||
          isMerchantForRestaurant(resource.data.restaurantId)
        ) &&
        changedOnly(['updatedAt']);
      allow delete: if false;
    }

    match /restaurants/{restaurantId} {
      allow get, list: if isSignedIn() &&
        (resource.data.active == true ||
          resource.data.ownerId == request.auth.uid ||
          isMerchantForRestaurant(restaurantId));
      allow create: if restaurantOwnerCanCreate();
      allow update: if restaurantOwnerCanUpdate() ||
        linkedMerchantCanClaimRestaurant(restaurantId) ||
        (
          isMerchantForRestaurant(restaurantId) &&
          request.resource.data.ownerId == resource.data.ownerId
        );
      allow delete: if false;
    }

    match /visits/{visitId} {
      allow get, list: if isSignedIn() &&
        (resource.data.userId == request.auth.uid ||
          isMerchantForRestaurant(resource.data.restaurantId));
      allow create: if isSignedIn() &&
        isMerchantForRestaurant(request.resource.data.restaurantId) &&
        request.resource.data.userId is string &&
        request.resource.data.timestamp is timestamp &&
        request.resource.data.checkInId is string &&
        request.resource.data.operationId == 'approveCheckIn:' + request.resource.data.checkInId &&
        getAfter(/databases/$(database)/documents/checkIns/$(request.resource.data.checkInId)).data.status == 'approved' &&
        getAfter(/databases/$(database)/documents/checkIns/$(request.resource.data.checkInId)).data.visitId == visitId &&
        getAfter(/databases/$(database)/documents/checkIns/$(request.resource.data.checkInId)).data.syncOperationId == request.resource.data.operationId;
      allow update, delete: if false;
    }

    match /rewards/{rewardId} {
      allow get, list: if isSignedIn() &&
        (resource.data.userId == request.auth.uid ||
          isMerchantForRestaurant(resource.data.restaurantId));
      allow create: if isSignedIn() &&
        isMerchantForRestaurant(request.resource.data.restaurantId) &&
        request.resource.data.userId is string &&
        request.resource.data.status == 'available';
      allow update: if isSignedIn() &&
        isMerchantForRestaurant(resource.data.restaurantId) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.restaurantId == resource.data.restaurantId &&
        request.resource.data.restaurantName == resource.data.restaurantName &&
        request.resource.data.label == resource.data.label &&
        request.resource.data.expiresAt == resource.data.expiresAt &&
        resource.data.status == 'available' &&
        request.resource.data.status == 'used' &&
        request.resource.data.redeemedAt is timestamp &&
        request.resource.data.redeemedBy == request.auth.uid &&
        changedOnly(['status', 'redeemedAt', 'redeemedBy']);
      allow delete: if false;
    }

    match /rewardDefinitions/{id} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() &&
        isMerchantForRestaurant(request.resource.data.restaurantId);
      allow update: if isSignedIn() &&
        isMerchantForRestaurant(resource.data.restaurantId) &&
        request.resource.data.restaurantId == resource.data.restaurantId;
      allow delete: if false;
    }

    match /exclusiveOffers/{id} {
      allow get, list: if isSignedIn() &&
        (resource.data.active == true ||
          isMerchantForRestaurant(resource.data.restaurantId));
      allow create: if isSignedIn() &&
        isMerchantForRestaurant(request.resource.data.restaurantId) &&
        request.resource.data.active is bool &&
        request.resource.data.title is string &&
        request.resource.data.startsAt is timestamp &&
        request.resource.data.endsAt is timestamp;
      allow update: if isSignedIn() &&
        isMerchantForRestaurant(resource.data.restaurantId) &&
        request.resource.data.restaurantId == resource.data.restaurantId &&
        request.resource.data.title is string &&
        request.resource.data.startsAt is timestamp &&
        request.resource.data.endsAt is timestamp;
      allow delete: if isSignedIn() &&
        isMerchantForRestaurant(resource.data.restaurantId);
    }

    match /checkIns/{id} {
      allow get, list: if isSignedIn() &&
        (resource.data.customerId == request.auth.uid ||
          isMerchantForRestaurant(resource.data.restaurantId));
      allow create: if isSignedIn() &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.restaurantId is string &&
        request.resource.data.requestedAt is timestamp &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.status == 'pending' &&
        hasOnlyFields([
          'customerId', 'restaurantId', 'requestedAt', 'expiresAt', 'status',
          'customerLatitude', 'customerLongitude', 'distanceMeters'
        ]);
      allow update: if isSignedIn() &&
        (
          (
            isMerchantForRestaurant(resource.data.restaurantId) &&
            resource.data.status == 'pending' &&
            request.resource.data.restaurantId == resource.data.restaurantId &&
            request.resource.data.customerId == resource.data.customerId &&
            (
              (
                request.resource.data.status == 'approved' &&
                request.resource.data.validatedBy == request.auth.uid &&
                request.resource.data.validatedAt is timestamp &&
                request.resource.data.pointsAwarded is int &&
                request.resource.data.pointsAwarded ==
                  get(/databases/$(database)/documents/restaurants/$(resource.data.restaurantId)).data.pointsPerVisit &&
                request.resource.data.visitId is string &&
                request.resource.data.syncOperationId == 'approveCheckIn:' + id &&
                existsAfter(/databases/$(database)/documents/visits/$(request.resource.data.visitId)) &&
                getAfter(/databases/$(database)/documents/visits/$(request.resource.data.visitId)).data.checkInId == id &&
                getAfter(/databases/$(database)/documents/visits/$(request.resource.data.visitId)).data.operationId == request.resource.data.syncOperationId &&
                changedOnly(['status', 'validatedAt', 'validatedBy', 'pointsAwarded', 'visitId', 'syncOperationId'])
              ) ||
              (
                request.resource.data.status == 'rejected' &&
                request.resource.data.rejectedBy == request.auth.uid &&
                request.resource.data.rejectedAt is timestamp &&
                request.resource.data.syncOperationId == 'rejectCheckIn:' + id &&
                changedOnly(['status', 'rejectedAt', 'rejectedBy', 'syncOperationId'])
              ) ||
              (
                request.resource.data.status == 'expired' &&
                changedOnly(['status'])
              )
            )
          ) ||
          (
            resource.data.customerId == request.auth.uid &&
            resource.data.status == 'pending' &&
            request.resource.data.restaurantId == resource.data.restaurantId &&
            request.resource.data.customerId == resource.data.customerId &&
            (
              (
                request.resource.data.status == 'cancelled' &&
                request.resource.data.cancelledAt is timestamp &&
                changedOnly(['status', 'cancelledAt'])
              ) ||
              (
                request.resource.data.status == 'expired' &&
                changedOnly(['status'])
              )
            )
          )
        );
      allow delete: if false;
    }

    match /notifications/{id} {
      allow get, list: if isSignedIn() &&
        resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
        (
          (
            request.resource.data.userId is string &&
            request.resource.data.restaurantId is string &&
            isMerchantForRestaurant(request.resource.data.restaurantId)
          ) ||
          (
            request.resource.data.type == 'check_in_requested' &&
            request.resource.data.userId ==
              get(/databases/$(database)/documents/restaurants/$(request.resource.data.restaurantId)).data.ownerId &&
            exists(/databases/$(database)/documents/checkIns/$(request.resource.data.relatedId)) &&
            get(/databases/$(database)/documents/checkIns/$(request.resource.data.relatedId)).data.customerId == request.auth.uid &&
            get(/databases/$(database)/documents/checkIns/$(request.resource.data.relatedId)).data.restaurantId == request.resource.data.restaurantId
          )
        );
      allow update: if isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.type == resource.data.type &&
        request.resource.data.title == resource.data.title &&
        request.resource.data.body == resource.data.body &&
        changedOnly(['read', 'isRead', 'readAt']);
      allow delete: if false;
    }

    match /wishlist/{id} {
      allow get, list: if isSignedIn() &&
        resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() &&
        resource.data.userId == request.auth.uid;
    }

    match /reviews/{id} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        id == request.resource.data.restaurantId + '_' + request.auth.uid &&
        request.resource.data.restaurantId is string &&
        request.resource.data.userName is string &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.comment is string &&
        request.resource.data.createdAt is timestamp &&
        hasOnlyFields([
          'userId', 'restaurantId', 'userName', 'rating', 'comment', 'createdAt'
        ]);
      allow delete: if false;
    }

    match /referrals/{id} {
      allow get, list: if isSignedIn() &&
        (resource.data.referrerId == request.auth.uid ||
          resource.data.referredUserId == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.referredUserId == request.auth.uid &&
        request.resource.data.referrerId is string &&
        request.resource.data.referrerId != request.auth.uid &&
        request.resource.data.referralCode is string &&
        exists(/databases/$(database)/documents/referralCodes/$(request.resource.data.referralCode)) &&
        get(/databases/$(database)/documents/referralCodes/$(request.resource.data.referralCode)).data.userId == request.resource.data.referrerId &&
        request.resource.data.status == 'pending' &&
        request.resource.data.pointsEarned == 0 &&
        (
          (
            !('restaurantId' in request.resource.data) &&
            id == 'initial_' + request.resource.data.referredUserId
          ) ||
          (
            request.resource.data.restaurantId is string &&
            id == request.resource.data.restaurantId + '_' + request.resource.data.referredUserId
          )
        );
      allow update: if false;
      allow delete: if false;
    }

    match /businessOperations/{id} {
      allow read, write: if false;
    }

    match /loyaltyTransactionLocks/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
